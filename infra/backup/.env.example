# Copy to infra/backup/.env (git-ignored) on the VPS and fill in.

# --- Supabase Postgres connection (Project Settings -> Database ->
# Connection string, URI format) -- NOT the REST API URL/service-role key used
# elsewhere in this repo. Needed by pg_dump here, and by the schema migrator
# (agent-worker: python -m worker.migrate), which keeps its own copy in
# agent-worker/.env.local.
#
# TWO WAYS THIS SILENTLY BREAKS, both of which have already cost time:
#
# 1. Special characters in the password must be percent-encoded. Supabase shows
#    you the raw password; a literal "@" in it makes the URI parser split there
#    and read the rest of your password as the hostname, so the error is a DNS
#    failure on a host name you have never seen. Encode:
#        @ -> %40    $ -> %24    + -> %2B    / -> %2F    : -> %3A
#    Simplest cure: reset the database password to letters and digits only.
#
# 2. Use port 5432 (direct or session pooler), NOT 6543 (transaction pooler).
#    The migrator takes a pg_advisory_lock so two workers can't migrate at
#    once, and advisory locks are session-scoped -- transaction pooling drops
#    them between statements.
SUPABASE_DB_URL=

# --- Same REST credentials the dashboard/worker already use ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Backblaze B2 (S3-compatible) -- from the bucket's "How to connect" page ---
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=

# How many days of daily backups to keep in the bucket. Older ones are
# deleted by backup-db.sh itself on every run.
BACKUP_RETENTION_DAYS=30
