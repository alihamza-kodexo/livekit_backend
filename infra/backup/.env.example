# Copy to infra/backup/.env (git-ignored) on the VPS and fill in.

# --- Supabase direct Postgres connection (Project Settings -> Database ->
# Connection string, URI format) -- NOT the REST API URL/service-role key
# used elsewhere in this repo. Only pg_dump needs this.
SUPABASE_DB_URL=

# --- Same REST credentials the dashboard/worker already use ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Backblaze B2 (S3-compatible) -- from the bucket's "How to connect" page ---
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=

# How many days of daily backups to keep in the bucket. Older ones are
# deleted by backup-db.sh itself on every run.
BACKUP_RETENTION_DAYS=30
