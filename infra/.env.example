# Copy this file to `.env` in the same folder (infra/.env) before running
# `docker compose up -d`. Never commit the real .env file.

# --- LiveKit self-signed credentials ---
# These are NOT issued by anyone — you invent them yourself, like a password.
# Generate strong random values, e.g.:
#   LIVEKIT_API_KEY:    openssl rand -hex 16
#   LIVEKIT_API_SECRET: openssl rand -hex 32
# The agent worker and dashboard backend will need these same two values
# to authenticate against this LiveKit server.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Redis password (used by both livekit-server and the SIP bridge) ---
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=
