# Copy to agent-worker/.env.local (git-ignored) and fill in.

# --- Supabase (same project as dashboard/.env.local) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- LiveKit (same server as infra/.env) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match roomConfig.agents[].agentName in infra/sip/dispatch-rule.example.json
LIVEKIT_AGENT_NAME=kodexo-inbound-agent
# CPU load above which this worker refuses calls. Leave BLANK (the default) to
# never refuse: LiveKit's load shedding is designed to hand a call to a less busy
# worker in a pool, and with a single worker there is no one to hand it to -- the
# call is simply dropped, with no error anywhere and nothing but a "marking as
# unavailable" line in this worker's log to show why the phone rang out. The
# framework's own default of 0.7 is crossed routinely by any box that also runs a
# dashboard or Docker. Set a number below 1.0 only once you run a pool.
WORKER_LOAD_THRESHOLD=

# --- STT / TTS (Deepgram covers both -- Nova-3 + Aura) ---
DEEPGRAM_API_KEY=

# --- LLM: default provider (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- LLM: DeepSeek, only needed if any agent has llm_provider='deepseek' ---
# Switchable per-agent from the dashboard at any time -- see VOICE_STACK_DECISION.md.
#
# These three are really "any OpenAI-compatible chat endpoint", not DeepSeek
# specifically. That matters for latency: DeepSeek's origin API measured ~1.6s
# for a one-sentence reply, which is slow for live voice, and the cause is its
# infrastructure and network path rather than the model. DeepSeek is open-weight,
# so the same model can be served from a US datacenter instead -- one hop from
# the VPS rather than a trip to the origin.
#
# To re-host, set all three together (the model ID is namespaced per provider):
#   DEEPSEEK_BASE_URL=https://api.deepinfra.com/v1/openai
#   DEEPSEEK_API_KEY=<your DeepInfra key>
#   DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Together AI works the same way with its own base URL and model naming.
#
# The worker sends DeepSeek's proprietary `thinking: disabled` parameter only
# when BASE_URL is the origin API -- other hosts 400 on unknown parameters.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Gemini. One key, two completely different engines. ---
# Needed if any agent has llm_provider='gemini' OR llm_provider='gemini_live'.
GEMINI_API_KEY=

# llm_provider='gemini' -- Gemini Flash as an ordinary text LLM inside the
# Deepgram pipeline (Flux STT -> Gemini -> Aura TTS). This is the default and
# the fastest option measured: 451ms best / 499ms median time-to-first-token
# for a one-sentence phone reply, against 535/648 for DeepSeek's origin API.
# See supabase/migrations/0019 for the full comparison.
#
# Keep this on a 2.x model unless you also change the worker: reasoning is
# disabled via `thinking_budget=0`, and the 3.x models reject that field in
# favour of `thinking_level`. A model that reasons before answering adds dead
# air to every single turn.
GEMINI_LLM_MODEL=gemini-2.5-flash

# llm_provider='gemini_live' -- speech-to-speech, replaces STT+LLM+TTS
# entirely for that agent. Cheaper, but it decides turn-taking server-side, so
# none of the Deepgram/Flux settings below reach it -- see
# VOICE_STACK_DECISION.md for the full list of what it gives up.
# MUST be a native-audio model for inbound calls. The 3.x live models
# (gemini-3.1-flash-live-preview and friends) can't accept a client-initiated
# first turn, so the agent never greets -- and if GEMINI_PROACTIVE_AUDIO is set
# as well, they reject the session outright and the call is silent end to end.
# From the phone both failures look the same: nobody ever speaks.
#
# Live models this key can use, verified against the API:
#   gemini-2.5-flash-native-audio-latest            <- default, greets fine
#   gemini-2.5-flash-native-audio-preview-12-2025
#   gemini-2.5-flash-native-audio-preview-09-2025
#   gemini-3.1-flash-live-preview                   <- cannot greet; avoid
GEMINI_MODEL=gemini-2.5-flash-native-audio-latest
# Gemini's "proactive audio": the model decides for itself whether speech was
# addressed to it and stays silent otherwise -- a second line of defence on a
# noisy phone line, on top of the activity-detection tuning the worker always
# applies (see entrypoint._gemini_activity_detection). Native-audio models
# only; leave empty on 3.x, which rejects the session outright.
GEMINI_PROACTIVE_AUDIO=

# The DEEPGRAM_* turn-taking settings below do NOT apply to gemini_live agents.
# That engine is speech-to-speech: no Deepgram STT or TTS is created for it at
# all, and its turn-taking is decided server-side by Gemini.

# --- Notifications (optional -- skipped if unset) ---
SLACK_WEBHOOK_URL=

# --- Call recording storage (Cloudinary) -- not wired up to any code path yet ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Turn taking / latency ------------------------------------------------
# Which Deepgram STT the worker runs. "flux" (default) uses Deepgram Flux,
# which reports end-of-turn from the speech itself instead of the session
# waiting on a fixed silence timer -- the largest latency win available on a
# phone call, where PSTN transit and jitter buffers already cost ~500ms that
# no setting can shorten. nova-3 stays wired as an automatic fallback if Flux
# is unavailable on the account or its socket drops mid-call.
# Set to "nova" to skip Flux entirely (one-variable rollback).
DEEPGRAM_STT_ENGINE=flux
DEEPGRAM_FLUX_MODEL=flux-general-en
# Confidence at which Flux calls the turn finished. Higher waits longer and
# interrupts less.
DEEPGRAM_FLUX_EOT_THRESHOLD=0.7
# Lower bar for a provisional end-of-turn, letting the LLM start early. Must
# be below DEEPGRAM_FLUX_EOT_THRESHOLD.
DEEPGRAM_FLUX_EAGER_EOT_THRESHOLD=0.5
# Ceiling on waiting for the threshold once speech stops.
DEEPGRAM_FLUX_EOT_TIMEOUT_MS=600
